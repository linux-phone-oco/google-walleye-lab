From 755287be2f97452104bbdec2aed5aaa2bb0da12a Mon Sep 17 00:00:00 2001
From: "walleye-builder.4c25be" <idunerg+walleye-builder.4c25be@gmail.com>
Date: Thu, 19 Nov 2026 14:35:41 +0100
Subject: [PATCH] dt-bindings: input: Add TI DRV2624 haptics driver

Document the properties the DRV2624 driver reads: the actuator type and
loop mode, the rated and overdrive voltages as raw register values, the
LRA frequencies and the wave shape, and the nRESET gpio.

Signed-off-by: grenudi <idunerg@gmail.com>
---
 .../devicetree/bindings/input/ti,drv2624.yaml | 104 ++++++++++++++++++
 1 file changed, 104 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/ti,drv2624.yaml

diff --git a/Documentation/devicetree/bindings/input/ti,drv2624.yaml b/Documentation/devicetree/bindings/input/ti,drv2624.yaml
new file mode 100644
index 000000000..cf4968908
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/ti,drv2624.yaml
@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/ti,drv2624.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments DRV2624 haptics driver
+
+description: |
+  Haptic driver for an LRA or ERM vibration motor, on an I2C bus. The
+  actuator is programmed once at probe from the properties below; playback
+  is real-time (RTP) and reaches user space through force feedback.
+
+  Product page: https://www.ti.com/product/DRV2624
+
+maintainers:
+  - Giuseppe Maggio <jertlok@proton.me>
+
+properties:
+  compatible:
+    const: ti,drv2624
+
+  reg:
+    maxItems: 1
+
+  reset-gpios:
+    description: GPIO wired to the part's active-low nRESET pin.
+    maxItems: 1
+
+  ti,actuator:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Actuator type, written to the N_ERM_LRA bit.
+    enum: [0, 1]
+    default: 1
+    # 0: ERM, 1: LRA
+
+  ti,smart-loop:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Loop mode, written to the LOOP bit.
+    enum: [0, 1]
+    default: 0
+    # 0: closed loop, 1: open loop
+
+  ti,rated-voltage:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Raw value of the RATED_VOLTAGE register (0 leaves the reset value).
+    minimum: 0
+    maximum: 255
+
+  ti,odclamp-voltage:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Raw value of the OD_CLAMP register (0 leaves the reset value).
+    minimum: 0
+    maximum: 255
+
+  ti,lra-frequency:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: |
+      Resonant frequency of the LRA in Hz, used for the drive time (0 leaves
+      the reset value). The drive time must fit its register, which in practice
+      means 139 Hz or more.
+    minimum: 0
+    maximum: 1000
+
+  ti,ol-lra-frequency:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Open-loop drive frequency in Hz. Defaults to ti,lra-frequency.
+    minimum: 40
+    maximum: 1000
+
+  ti,lra-wave-shape:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Open-loop drive wave shape.
+    enum: [0, 1]
+    default: 0
+    # 0: square, 1: sine
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        vibrator@5a {
+            compatible = "ti,drv2624";
+            reg = <0x5a>;
+            reset-gpios = <&tlmm 95 GPIO_ACTIVE_LOW>;
+            ti,actuator = <1>;
+            ti,smart-loop = <0>;
+            ti,rated-voltage = <77>;
+            ti,odclamp-voltage = <165>;
+            ti,lra-frequency = <155>;
+            ti,ol-lra-frequency = <155>;
+            ti,lra-wave-shape = <0>;
+        };
+    };

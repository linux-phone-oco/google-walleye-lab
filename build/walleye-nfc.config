# walleye-nfc-dts-node-image: the NXP NCI NFC controller (the Pixel 2's PN553) over I2C: the NFC core and NCI layer, the nxp-nci driver and its i2c part.
# Built in, not modules: the initramfs carries none. A fragment of its own, merged after walleye.config, so the kernels and images that do not name it stay as they were.
# NFC stays a module while RFKILL is one (it depends on RFKILL || !RFKILL)
CONFIG_RFKILL=y
CONFIG_NFC=y
CONFIG_NFC_NCI=y
CONFIG_NFC_NXP_NCI=y
CONFIG_NFC_NXP_NCI_I2C=y

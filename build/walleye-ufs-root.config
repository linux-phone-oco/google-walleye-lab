# UFS-root image (backlog walleye-install-ufs-root-image): the root is the card's system partition, mounted read-only with a tmpfs overlay by the initramfs, which carries no modules.
# defconfig has OVERLAY_FS =m; ext4, the sd disk driver, the UFS host and its phy are already built in (walleye.config, defconfig).
CONFIG_OVERLAY_FS=y

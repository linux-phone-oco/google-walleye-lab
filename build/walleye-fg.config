# Fuel gauge image (item walleye-fuel-gauge): on top of walleye.config, the PMI8998 fuel gauge driver built in (the initramfs carries no modules) and CONFIG_DYNAMIC_DEBUG,
# so the boot command line can switch the driver's dev_dbg lines on (dyndbg="file drivers/power/supply/pmi8998_fg.c +p") and the banner shows what the gauge did.
CONFIG_BATTERY_PMI8998_FG=y
CONFIG_DYNAMIC_DEBUG=y

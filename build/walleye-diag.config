# Diagnostic kernel (backlog walleye-build-gpio-diag-kernel): on top of walleye.config, makes the gpio and pinctrl cores able to say, at boot, why the touch power gpio defers.
# CONFIG_DYNAMIC_DEBUG lets the boot command line turn on the pr_debug lines of named files (dyndbg=...); DEBUG_GPIO adds gpiolib's own checks and compiles drivers/gpio with -DDEBUG (more boot output from every gpio driver). Nothing else is asked for.
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_GPIO=y

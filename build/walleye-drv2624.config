# DRV2624 haptics image (item walleye-drv2624-image): on top of walleye.config, the TI DRV2624 driver built in (the initramfs carries no modules),
# and CONFIG_DYNAMIC_DEBUG so the command line can switch the driver's one dev_dbg (the chip id) on (dyndbg="file drivers/input/misc/drv2624.c +p").
CONFIG_INPUT_DRV2624_HAPTICS=y
CONFIG_DYNAMIC_DEBUG=y

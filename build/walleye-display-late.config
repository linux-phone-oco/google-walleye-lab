# Config fragment merged after walleye.config for the display LATE PROBE (item walleye-display-late-probe-image): the display path is MODULES, loaded by hand from the shell, so nothing display-related probes at boot
# (d0, the display kernel with no display nodes, boots the shell; d1 with the nodes does not). walleye-display.config's =y lines are not used; the helpers its comment names stay =y as in d0.
CONFIG_MODULES=y
CONFIG_DRM=m
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3FA5=m
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# DRM_MSM "depends on X || X=n": built in, as in d0
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_SMEM=y
# the kernel log to the host before the display modules load: netconsole targets are made from the shell through configfs (it also reaches a panic)
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
# the probe loads the display modules with dyndbg=+p (their dev_dbg lines on), so the log says more than the probe's own errors
CONFIG_DYNAMIC_DEBUG=y

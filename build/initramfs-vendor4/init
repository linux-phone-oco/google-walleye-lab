#!/bin/busybox sh
# vendor-gadget4 = the control's kernel with an IDLE init: no gadget, no USB, no network. It writes a marker to /dev/kmsg, mounts /proc only
# (for the sysrq fallback), writes an alive marker every 30 s, and after 120 s reboots (reboot -f, then sysrq b). Splits "our gadget code panics"
# from "the vendor kernel cannot live ~60 s without Android userspace". Never exits (an init that ends is a kernel panic); no `set -e`.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
say "vendor-gadget4 idle init start (before any mount)"
mount -t proc proc /proc
say "proc mounted, kernel $(uname -r); idling, reboot at 120 s"
n=0
while [ $n -lt 4 ]; do sleep 30; n=$((n+1)); say "alive $((n*30)) s"; done
say "self-reboot now"; sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

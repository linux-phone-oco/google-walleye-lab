#!/bin/busybox sh
# vendor-gadget-n1 (walleye-ncm-noattr-images): vendor-gadget5a's init (kmsg marker, 30 s alive markers, reboot -f at 120 s, sysrq b fallback) plus the ncm
# step without ever touching the function's own settings: the cause of the 5b panic is writes to them while the function has no network device yet (made at the UDC bind).
# n1 = 5b4 minus the two settings writes: function, config with its string, symlink; no UDC bind, no telnetd.
# Never exits (an init that ends is a kernel panic); no `set -e`; every step says what it is about to do BEFORE it does it. Steps run before the timer loop.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
say "vendor-gadget-n1 init start (before any mount)"
mount -t proc proc /proc
say "proc mounted, kernel $(uname -r); step n1"
mount -t sysfs sys /sys
mkdir -p /sys/kernel/config
mount -t configfs none /sys/kernel/config
say "configfs mounted"
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline)" > $G/strings/0x409/product
say "step n1: about to mkdir functions/ncm.usb0"
mkdir -p $G/functions/ncm.usb0
say "step n1: about to mkdir configs/c.1/strings/0x409"
mkdir -p $G/configs/c.1/strings/0x409
echo "NCM" > $G/configs/c.1/strings/0x409/configuration
say "step n1: about to symlink the function into configs/c.1"
ln -s $G/functions/ncm.usb0 $G/configs/c.1/
say "step n1 done: ncm function and config, no setting written"
n=0
while [ $n -lt 4 ]; do sleep 30; n=$((n+1)); say "alive $((n*30)) s"; done
say "self-reboot now"; sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

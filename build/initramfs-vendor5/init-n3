#!/bin/busybox sh
# vendor-gadget-n3 (walleye-ffs-helper-build): the control's kernel, our ramdisk. A FunctionFS gadget (functions/ffs.acm, no function attribute written) whose ep0 the static helper /bin/ffs-acm
# feeds: descriptors and strings first, then the UDC bind, then a pty shell bridged to the bulk endpoints; the host should get a /dev/ttyACM*.
# The mass-storage log window is not in this image (n3 is one change from n2: the channel). Never exits (an init that ends is a kernel panic); no `set -e`; every step says what it is about to do BEFORE it does it.
# Reboots itself at 180 s (reboot -f, then sysrq b).
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
say "vendor-gadget-n3 init start (before any mount)"
mount -t proc proc /proc
say "proc mounted, kernel $(uname -r); step n3"
mount -t sysfs sys /sys
mkdir -p /sys/kernel/config /dev/pts
mount -t configfs none /sys/kernel/config
say "configfs mounted"
mount -t devpts devpts /dev/pts
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline)" > $G/strings/0x409/product
say "step n3: about to mkdir functions/ffs.acm"
mkdir -p $G/functions/ffs.acm
say "step n3: about to mkdir configs/c.1/strings/0x409"
mkdir -p $G/configs/c.1/strings/0x409
echo "ACM" > $G/configs/c.1/strings/0x409/configuration
say "step n3: about to symlink the function into configs/c.1"
ln -s $G/functions/ffs.acm $G/configs/c.1/
say "step n3: about to mount functionfs acm on /dev/ffs"
mount -t functionfs acm /dev/ffs && say "functionfs mounted: $(ls /dev/ffs 2>&1 | tr '\n' ' ')"
say "step n3: about to start /bin/ffs-acm (it writes ep0, then binds the UDC)"
/bin/ffs-acm &
n=0
while [ $n -lt 6 ]; do sleep 30; n=$((n+1)); say "alive $((n*30)) s; ffs: $(ls /dev/ffs 2>&1 | tr '\n' ' ')"; done
say "self-reboot now"; sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

#!/bin/busybox sh
# vendor-gadget5a = vendor-gadget4's idle init (kmsg marker, 30 s alive markers, reboot -f at 120 s, sysrq b fallback) plus the gadget
# bring-up UP TO STEP a ONLY (configfs + gadget dir). The bisect of the gadget panic: gadget4 (no gadget) returns by itself, gadget2/3 (full gadget) panic ~75 s in.
# Never exits (an init that ends is a kernel panic); no `set -e`; every step reports and goes on. Steps run before the timer loop.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
say "vendor-gadget5a init start (before any mount)"
mount -t proc proc /proc
say "proc mounted, kernel $(uname -r); step a: configfs + gadget dir"
mount -t sysfs sys /sys
mkdir -p /sys/kernel/config
mount -t configfs none /sys/kernel/config
say "configfs mounted"
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline)" > $G/strings/0x409/product
say "step a done: gadget dir with ids and strings, no function"
n=0
while [ $n -lt 4 ]; do sleep 30; n=$((n+1)); say "alive $((n*30)) s"; done
say "self-reboot now"; sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

#!/bin/busybox sh
# vendor-facts-vf1 (walleye-vendor-facts-dump): the control's kernel, our ramdisk. Same one-way window as m1 (mass_storage LUN, read-only for the host, gadget order dir, mass_storage, bind),
# but the LUN is an 8 MiB file holding a length-prefixed gzipped tar of the RUNNING hardware's facts (decision 2026-11-18-walleye-vendor-kernel-as-instrument): the device tree as merged
# (/proc/device-tree, one file per property; no raw fdt: it holds the properties dropped by name), debugfs clk_summary, regulator_summary, pinctrl, gpio, usb and dwc3, /proc/interrupts, iomem, ioports,
# /sys/class/udc, dmesg. Every 10 s the tar is rebuilt and the blob rewritten in place while it grows; 90 s, then reboot -f (sysrq b after).
# Window layout: bytes 0..63 header "WALLEYE-VF1 LEN=<10 digits> ROUND=<2 digits>" padded with spaces, newline at 63; bytes 64.. the gzip stream of LEN bytes.
# Redaction (nothing identifying leaves the phone): no device-tree property named *mac-address*, *bdaddr*, *serial-number*, *serialno*, *imei*; no /sys/class/net; /proc/cpuinfo Serial line dropped; dt/chosen/bootargs and every text file
# have serialno=..., 15-digit runs and MAC-shaped words (: and - forms) blanked.
# Never exits (an init that ends is a kernel panic); no `set -e`; every step says what it is about to do BEFORE it does it; no write to the phone's storage.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
say "vendor-facts-vf1 init start (before any mount)"
mount -t proc proc /proc
say "proc mounted, kernel $(uname -r); step vf1"
mount -t sysfs sys /sys
mkdir -p /sys/kernel/config /sys/kernel/debug /tmp
mount -t configfs none /sys/kernel/config
say "configfs mounted"
mount -t debugfs none /sys/kernel/debug
say "debugfs mounted: $(ls /sys/kernel/debug 2>&1 | tr '\n' ' ')"
LOGF=/tmp/walleye-log.img
say "step vf1: about to create the 8 MiB log file"
dd if=/dev/zero of=$LOGF bs=1024 count=8192 2>/dev/null
printf '%-63s\n' "WALLEYE-VF1 LEN=0000000000 ROUND=00" | dd of=$LOGF bs=64 count=1 conv=notrunc 2>/dev/null
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline)" > $G/strings/0x409/product
say "step vf1: about to mkdir functions/mass_storage.0"
mkdir -p $G/functions/mass_storage.0
L=$G/functions/mass_storage.0/lun.0
say "vf1 lun.0 has: $(ls $L 2>&1 | tr '\n' ' ')"
for a in ro removable; do if [ -e $L/$a ]; then say "step vf1: about to write lun.0/$a"; echo 1 > $L/$a; else say "vf1: no lun.0/$a"; fi; done
for a in cdrom nofua; do if [ -e $L/$a ]; then say "step vf1: about to write lun.0/$a"; echo 0 > $L/$a; else say "vf1: no lun.0/$a"; fi; done
say "step vf1: about to set lun.0/file"
echo $LOGF > $L/file
say "vf1 lun.0/file now: $(cat $L/file 2>&1)"
say "step vf1: about to mkdir configs/c.1/strings/0x409"
mkdir -p $G/configs/c.1/strings/0x409
echo "MSC" > $G/configs/c.1/strings/0x409/configuration
say "step vf1: about to symlink the function into configs/c.1"
ln -s $G/functions/mass_storage.0 $G/configs/c.1/
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ]; then say "NO UDC"; else say "step vf1: about to bind $UDC"; echo "$UDC" > $G/UDC && say "gadget bound to $UDC"; fi

V=/tmp/vf
# grab SRC DEST: one file read with a 3 s limit (a debugfs file may block); a missing file leaves nothing
grab() { [ -e "$1" ] || return 0; mkdir -p "$(dirname "$2")"; timeout 3 cat "$1" > "$2" 2>/dev/null; }
# grabdir DIR DESTDIR: every regular file one level or two below DIR
grabdir() { [ -d "$1" ] || return 0; for f in "$1"/* "$1"/*/*; do [ -f "$f" ] && grab "$f" "$2/${f#$1/}"; done; }
redact() { # the text files under $V; of the device tree only chosen/bootargs (text, may carry the serial); the rest of dt/ has no identifying property by name
  [ -f $V/dt/chosen/bootargs ] && sed -i -e "s/serialno[= :][^ ]*/serialno=REDACTED/g" $V/dt/chosen/bootargs 2>/dev/null
  for f in $(find $V -type f ! -path "$V/dt/*" ! -name '*.dtb' 2>/dev/null); do
    sed -i -e 's/serialno[= :][^ ]*/serialno=REDACTED/g' -e 's/[0-9]\{15\}/IMEI-SHAPED/g' -e 's/\([0-9a-fA-F][0-9a-fA-F]-\)\{5\}[0-9a-fA-F][0-9a-fA-F]/XX-XX-XX-XX-XX-XX/g' \
      -e 's/\([0-9a-fA-F][0-9a-fA-F]:\)\{5\}[0-9a-fA-F][0-9a-fA-F]/XX:XX:XX:XX:XX:XX/g' "$f" 2>/dev/null
  done
}
collect_static() {
  say "step vf1: about to collect the device tree"
  mkdir -p $V/dt
  (cd /proc/device-tree 2>/dev/null && find . -type f 2>/dev/null) | while IFS= read -r p; do
    case "${p##*/}" in *mac-address*|*bdaddr*|*bd-addr*|*bd_addr*|*serial-number*|*serialno*|*imei*|*IMEI*|*macaddr*) continue;; esac
    grab "/proc/device-tree/$p" "$V/dt/$p"
  done
  grab /proc/cmdline $V/cmdline
  grab /proc/iomem $V/iomem
  grab /proc/ioports $V/ioports
  grab /proc/version $V/version
  grab /proc/devices $V/devices
  grab /proc/mounts $V/mounts
  grep -v -i '^serial' /proc/cpuinfo > $V/cpuinfo 2>/dev/null
  grab /sys/kernel/debug/pinctrl/pinctrl-maps $V/debugfs/pinctrl/pinctrl-maps
  grab /sys/kernel/debug/pinctrl/pinctrl-devices $V/debugfs/pinctrl/pinctrl-devices
  grab /sys/kernel/debug/pinctrl/pinctrl-handles $V/debugfs/pinctrl/pinctrl-handles
  say "static facts collected"
}
collect_dynamic() {
  grab /proc/interrupts $V/interrupts
  grab /sys/kernel/debug/clk/clk_summary $V/debugfs/clk_summary
  grab /sys/kernel/debug/regulator/regulator_summary $V/debugfs/regulator_summary
  grab /sys/kernel/debug/gpio $V/debugfs/gpio
  [ -z "$NOCLK" ] && grab /sys/kernel/debug/clk/clk_dump $V/debugfs/clk_dump
  grab /sys/kernel/debug/pinctrl/pinctrl-handles $V/debugfs/pinctrl/pinctrl-handles
  for d in /sys/kernel/debug/pinctrl/*; do [ -d "$d" ] && grabdir "$d" "$V/debugfs/pinctrl/${d##*/}"; done
  grabdir /sys/kernel/debug/usb $V/debugfs/usb
  for d in /sys/kernel/debug/*dwc3* /sys/kernel/debug/*.usb /sys/kernel/debug/*usb*; do [ -d "$d" ] && grabdir "$d" "$V/debugfs/${d##*/}"; done
  mkdir -p $V/sys
  ls -l /sys/class/udc > $V/sys/udc-list 2>&1
  for u in /sys/class/udc/*; do [ -d "$u" ] && for at in state speed current_speed is_a_peripheral maximum_speed; do grab "$u/$at" "$V/sys/udc/${u##*/}/$at"; done; done
  grab /sys/kernel/config/usb_gadget/g1/UDC $V/sys/gadget-UDC
  ls /sys/class/power_supply > $V/sys/power_supply-list 2>&1
  ls /sys/bus/platform/devices > $V/sys/platform-devices 2>&1
  ls /sys/bus/platform/drivers > $V/sys/platform-drivers 2>&1
  dmesg > $V/dmesg 2>&1
}
n=0
rm -rf $V; mkdir -p $V
while [ $n -lt 9 ]; do
  say "step vf1: round $n about to collect"
  [ $n -eq 0 ] && collect_static
  collect_dynamic
  redact
  # the tar, gzipped; if it would overflow the window, the dmesg and clk_dump (the largest changing files) are thinned first
  (cd $V && tar cf - . 2>/dev/null | gzip -c > /tmp/vf.tgz)
  SZ=$(stat -c %s /tmp/vf.tgz)
  if [ "$SZ" -gt 8388000 ]; then NOCLK=1; rm -f $V/debugfs/clk_dump; (cd $V && tar cf - . 2>/dev/null | gzip -c > /tmp/vf.tgz); SZ=$(stat -c %s /tmp/vf.tgz); fi
  if [ "$SZ" -le 8388000 ]; then
    # body first, then the header with its length: a reader that sees an old header sees an old, shorter prefix of the new stream, which it fails to gunzip and retries
    dd if=/tmp/vf.tgz of=$LOGF bs=64 seek=1 conv=notrunc 2>/dev/null
    printf '%-63s\n' "$(printf 'WALLEYE-VF1 LEN=%010d ROUND=%02d' "$SZ" "$n")" | dd of=$LOGF bs=64 count=1 conv=notrunc 2>/dev/null
    say "vf1 round $n: window holds $SZ bytes"
  else
    say "vf1 round $n: blob $SZ bytes does not fit, window unchanged"
  fi
  n=$((n+1))
  sleep 10
done
say "self-reboot now"; sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

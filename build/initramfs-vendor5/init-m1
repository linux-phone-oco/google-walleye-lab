#!/bin/busybox sh
# vendor-gadget-m1 (walleye-massstorage-window): the control's kernel, our ramdisk. A mass_storage gadget as a one-way log window (decision walleye-host-channel-order):
# the LUN is a 2 MiB file in the ramdisk, read-only for the host, that this init rewrites in place every 5 s with kmsg marker, uname, cmdline, dmesg tail, mounts and a heartbeat
# counter. No network function, so none of ncm's attribute writes; only the mass_storage attributes file, ro, removable, cdrom, nofua, each written only if it exists.
# Never exits (an init that ends is a kernel panic); no `set -e`; every step says what it is about to do BEFORE it does it. Reboots itself at 180 s (reboot -f, then sysrq b).
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
say "vendor-gadget-m1 init start (before any mount)"
mount -t proc proc /proc
say "proc mounted, kernel $(uname -r); step m1"
mount -t sysfs sys /sys
mkdir -p /sys/kernel/config /tmp
mount -t configfs none /sys/kernel/config
say "configfs mounted"
LOGF=/tmp/walleye-log.img
say "step m1: about to create the 2 MiB log file"
dd if=/dev/zero of=$LOGF bs=1024 count=2048 2>/dev/null
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline)" > $G/strings/0x409/product
say "step m1: about to mkdir functions/mass_storage.0"
mkdir -p $G/functions/mass_storage.0
L=$G/functions/mass_storage.0/lun.0
say "m1 lun.0 has: $(ls $L 2>&1 | tr '\n' ' ')"
for a in ro removable; do if [ -e $L/$a ]; then say "step m1: about to write lun.0/$a"; echo 1 > $L/$a; else say "m1: no lun.0/$a"; fi; done
for a in cdrom nofua; do if [ -e $L/$a ]; then say "step m1: about to write lun.0/$a"; echo 0 > $L/$a; else say "m1: no lun.0/$a"; fi; done
say "step m1: about to set lun.0/file"
echo $LOGF > $L/file
say "m1 lun.0/file now: $(cat $L/file 2>&1)"
say "step m1: about to mkdir configs/c.1/strings/0x409"
mkdir -p $G/configs/c.1/strings/0x409
echo "MSC" > $G/configs/c.1/strings/0x409/configuration
say "step m1: about to symlink the function into configs/c.1"
ln -s $G/functions/mass_storage.0 $G/configs/c.1/
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ]; then say "NO UDC"; else say "step m1: about to bind $UDC"; echo "$UDC" > $G/UDC && say "gadget bound to $UDC"; fi

# the window: every 5 s the whole first 64 KiB of the file is rewritten in place (text, padded with NULs to 64 KiB so no stale tail), 36 rounds = 180 s
n=0
while [ $n -lt 36 ]; do
  {
    echo "WALLEYE-LOG m1 beat=$n up=$(cut -d' ' -f1 /proc/uptime)s"
    echo "--- uname"; uname -a
    echo "--- cmdline"; cat /proc/cmdline
    echo "--- mounts"; cat /proc/mounts
    echo "--- udc"; ls /sys/class/udc 2>&1; cat /sys/kernel/config/usb_gadget/g1/UDC 2>&1
    echo "--- dmesg tail"; dmesg 2>&1 | tail -n 150 | tail -c 50000
    echo "--- end beat=$n"
  } > /tmp/walleye-text 2>&1
  dd if=/tmp/walleye-text of=$LOGF bs=65536 count=1 conv=sync,notrunc 2>/dev/null
  n=$((n+1))
  sleep 5
done
say "self-reboot now"; sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

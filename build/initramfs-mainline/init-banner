#!/bin/busybox sh
# banner (backlog walleye-build-banner-init): the mainline gadget reduced to what a reader needs. One function, acm.GS0. The writer starts right after the function is made and, as soon as
# /dev/ttyGS0 exists, puts a banner line on it about every 2 s (each line is its own open-write-close; with no host reading, lines may queue and arrive together), whether or not anyone
# has the port open. It is a subshell of its own: a blocked tty stalls nothing. Every step puts its line on /dev/kmsg BEFORE it does the step, and the banner carries the last one.
# The SoC watchdog is opened and petted every 2 s by its own subshell, which after 90 beats (~180 s from the open) does reboot -f, sysrq b behind it.
# Never exits (an init that ends is a kernel panic); no `set -e`; no special builtin (exec, `:`) carries a redirect that can fail in the main shell (a failed one ends the shell).
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
STEP=0
BANNERLOG=/tmp/banner-steps
say() { STEP=$((STEP+1)); echo "walleye-banner: step $STEP: $*" > /dev/kmsg 2>/dev/null; echo "step $STEP $*" >> $BANNERLOG 2>/dev/null; }
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /sys/kernel/config /tmp
true > $BANNERLOG 2>/dev/null
say "banner init start, kernel $(uname -r)"
mount -t configfs none /sys/kernel/config
say "about to start the watchdog petter"
# the petter: opens /dev/watchdog itself (its own subshell: a failed open ends only it), pets every 2 s, reboots after 90 beats
(
  if [ -e /dev/watchdog ]; then
    exec 3> /dev/watchdog || exit 0
  fi
  n=0
  while [ $n -lt 90 ]; do echo >&3 2>/dev/null; n=$((n+1)); sleep 2; done
  echo "walleye-banner: self-reboot now" > /dev/kmsg 2>/dev/null
  sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
) &
[ -e /dev/watchdog ] || say "NO /dev/watchdog"
G=/sys/kernel/config/usb_gadget/g1
say "about to create the gadget g1 (1d6b:0104)"
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline banner)" > $G/strings/0x409/product
say "about to mkdir functions/acm.GS0"
mkdir -p $G/functions/acm.GS0
# the banner writer, started before the bind: it waits for the tty node, then writes
(
  b=0
  while :; do
    if [ -c /dev/ttyGS0 ]; then
      echo "WALLEYE-BANNER beat=$b up=$(cut -d' ' -f1 /proc/uptime)s steps=$(wc -l < $BANNERLOG) last=[$(tail -n1 $BANNERLOG)]" > /dev/ttyGS0 2>/dev/null
      b=$((b+1))
    fi
    sleep 2
  done
) &
say "banner writer started"
mkdir -p $G/configs/c.1/strings/0x409
echo "ACM" > $G/configs/c.1/strings/0x409/configuration
say "about to symlink acm.GS0 into configs/c.1"
ln -s $G/functions/acm.GS0 $G/configs/c.1/
n=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $n -lt 30 ]; do sleep 1; n=$((n+1)); done
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ]; then say "NO UDC after ${n}s"; else say "about to bind $UDC (waited ${n}s)"; echo "$UDC" > $G/UDC && say "gadget bound to $UDC"; fi
while :; do sleep 3600; done

#!/bin/sh
# pon-block (item walleye-wdt-pon-control-procedure; research walleye-pon-read-after-bite-the-way): the PMIC's PON block read RAW, registers 0xC0..0xCB of the PON peripheral (PM8998 is PON gen2: PON_REASON1 0xC0, WARM_RESET_REASON1 0xC2,
# POFF_REASON1 0xC5, PON_OFF_REASON 0xC7, FAULT_REASON1 0xC8, S3_RESET_REASON 0xCA), one line "pon-block 0xC0=VV ... 0xCB=VV src=[REGMAP]" for each regmap that has them, READS ONLY: it names no register's meaning, the reader of the line does.
# The kernel's regmap `registers` file has one fixed-width line "ADDR: VAL" per register (drivers/base/regmap/regmap-debugfs.c) and reads only the registers from the file position on, so each register is one dd of one line, as /bin/pon-regs does;
# a line that is not the register asked for (a sparse map) falls back to grep; a failed read shows XX in the kernel's line and ?? here. DBG and NOMOUNT are for the host selftest.
DBG=${DBG:-/sys/kernel/debug}
D=$DBG/regmap
[ -d "$D" ] || [ -n "${NOMOUNT:-}" ] || mount -t debugfs none "$DBG" 2>/dev/null
found=0; names=
for d in "$D"/*; do
  f=$d/registers
  [ -f "$f" ] || continue
  n=${d##*/}; names="$names${names:+,}$n"
  E=$(head -n1 "$f" 2>/dev/null | wc -c)
  [ "$E" -gt 4 ] || continue
  line=; any=0
  for r in c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 ca cb; do
    l=$(dd if="$f" bs="$E" skip=$((0x800 + 0x$r)) count=1 2>/dev/null)
    case $l in *8$r:*) ;; *) l=$(grep -E "^0*8$r:" "$f" 2>/dev/null | head -n1);; esac
    v=$(printf '%s\n' "$l" | sed -n "s/^0*8$r: *\([0-9a-fA-F][0-9a-fA-F]*\).*/\1/p" | head -n1)
    [ -n "$v" ] && any=1
    line="$line 0x$r=${v:-??}"
  done
  [ $any -eq 1 ] || continue
  echo "pon-block$line src=[$n]"; found=1
done
if [ $found -eq 0 ]; then
  dbg=no; [ -d "$D" ] && dbg=yes
  echo "pon-block none regmaps=[$names] dbgfs=[$dbg]"
fi

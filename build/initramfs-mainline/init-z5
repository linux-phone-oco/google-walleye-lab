#!/bin/busybox sh
# z5 (backlog walleye-banner-shell) = banner2's init (init-banner: one ACM function, a banner on /dev/ttyGS0 every 2 s that is proven to reach the host with a plain cat) PLUS z4's console
# block (a shell on the same port) PLUS the shell's state in the banner, so a silent shell explains itself. The banner line keeps init-banner's fields and ends with
#   shell=[started=yes|no n=STARTS pid=PID alive=yes|no rc=LASTEXIT|- probe=RC err=[FIRST ERROR LINE|none]]
# and every 10th beat from beat 3 a WALLEYE-BANNER-INFO line says what busybox offers (applet count; ash sh cttyhack setsid stty as y/n) and the tty's flags (echo icanon hupcl) after the console's stty.
# The console block's open, stty and a probe start (setsid busybox ash -c : on the tty, output to a file) put their stderr in /tmp/sh.err (reset at each start); the banner shows its first line.
# Unlike banner2 the console keeps the tty open, so banner lines written before the host opens the port queue (up to the tty buffer) and arrive first, stale; each line starts with a newline so the shell prompt cannot swallow it. No /tmp/hold: the watchdog reboots after ~180 s.
# The SoC watchdog is opened and petted every 2 s by its own subshell, which after 90 beats (~180 s from the open) does reboot -f, sysrq b behind it.
# Never exits (an init that ends is a kernel panic); no `set -e`; no special builtin (exec, `:`) carries a redirect that can fail in the main shell (a failed one ends the shell).
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
TTY=/dev/ttyGS0
SH=/tmp/sh
STEP=0
BANNERLOG=/tmp/banner-steps
say() { STEP=$((STEP+1)); echo "walleye-banner: step $STEP: $*" > /dev/kmsg 2>/dev/null; echo "step $STEP $*" >> $BANNERLOG 2>/dev/null; }
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /sys/kernel/config /tmp
true > $BANNERLOG 2>/dev/null
say "z5 init start, kernel $(uname -r)"
mount -t configfs none /sys/kernel/config
say "about to start the watchdog petter"
# the petter: opens /dev/watchdog itself (its own subshell: a failed open ends only it), pets every 2 s, reboots after 90 beats
(
  if [ -e /dev/watchdog ]; then
    exec 3> /dev/watchdog || exit 0
  fi
  n=0
  while [ $n -lt 90 ]; do echo >&3 2>/dev/null; n=$((n+1)); sleep 2; done
  echo "walleye-banner: self-reboot now" > /dev/kmsg 2>/dev/null
  sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
) &
[ -e /dev/watchdog ] || say "NO /dev/watchdog"
G=/sys/kernel/config/usb_gadget/g1
say "about to create the gadget g1 (1d6b:0104)"
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline banner shell)" > $G/strings/0x409/product
say "about to mkdir functions/acm.GS0"
mkdir -p $G/functions/acm.GS0
# the banner writer, started before the bind: it waits for the tty node, then writes
(
  b=0
  while :; do
    if [ -c $TTY ]; then
      S=no; N=0; P=-; RC=-; PR=-; TTYSUM=unknown
      [ -f $SH.state ] && . $SH.state 2>/dev/null
      A=no; [ "$P" != - ] && kill -0 "$P" 2>/dev/null && A=yes
      E=$(head -n1 $SH.err 2>/dev/null | tr -d '\r' | cut -c1-80); [ -n "$E" ] || E=none
      [ -f $SH.state ] || E="console block not run yet"
      printf "\n%s\n" "WALLEYE-BANNER beat=$b up=$(cut -d' ' -f1 /proc/uptime)s steps=$(wc -l < $BANNERLOG) last=[$(tail -n1 $BANNERLOG)] shell=[started=$S n=$N pid=$P alive=$A rc=$RC probe=$PR err=[$E]]" > $TTY 2>/dev/null
      if [ $b -ge 3 ] && [ $((b % 10)) -eq 3 ]; then
        L=$(busybox --list 2>/dev/null)
        have() { case "
$L
" in *"
$1
"*) echo y;; *) echo n;; esac; }
        printf "\n%s\n" "WALLEYE-BANNER-INFO beat=$b busybox-applets=$(echo "$L" | wc -l) ash=$(have ash) sh=$(have sh) cttyhack=$(have cttyhack) setsid=$(have setsid) stty=$(have stty) tty=[$TTYSUM]" > $TTY 2>/dev/null
      fi
      b=$((b+1))
    fi
    sleep 2
  done
) &
say "banner writer started"
mkdir -p $G/configs/c.1/strings/0x409
echo "ACM" > $G/configs/c.1/strings/0x409/configuration
say "about to symlink acm.GS0 into configs/c.1"
ln -s $G/functions/acm.GS0 $G/configs/c.1/
n=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $n -lt 30 ]; do sleep 1; n=$((n+1)); done
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ]; then say "NO UDC after ${n}s"; else say "about to bind $UDC (waited ${n}s)"; echo "$UDC" > $G/UDC && say "gadget bound to $UDC"; fi

# the console (z4's block, backlog walleye-shell-reliable, with its state kept for the banner): the port is opened ONCE here (fd 4) and kept; raw, no echo, no hangup on close (stty); the shell runs in
# its own session (setsid) on fd 4 and is respawned at once when it ends (one that lived under 20 s (t0, t1 are hundredths of a second) waits 1 s first). Each start writes /tmp/sh.state (shell variables the banner sources) after its steps.
(
  n=0
  st() { { echo "S=$1; N=$n; P=$2; RC=$3; PR=$4; TTYSUM=$5"; } > $SH.state.new 2>/dev/null && mv $SH.state.new $SH.state; }
  st no - - - unknown
  while :; do
    if [ -c $TTY ]; then
      n=$((n+1))
      true > $SH.err
      { command exec 4<> $TTY; } 2>> $SH.err || { st no - - - unknown; sleep 1; continue; }
      stty -F $TTY raw -echo -hupcl 2>> $SH.err || echo "stty on $TTY failed" >> $SH.err
      A=" $(stty -F $TTY -a 2>/dev/null | tr '\n;' '  ') "
      flag() { case "$A" in *" -$1 "*) echo "$1=off";; *" $1 "*) echo "$1=on";; *) echo "$1=?";; esac; }
      TS="$(flag echo),$(flag icanon),$(flag hupcl)"
      setsid busybox ash -c : <&4 >> $SH.err 2>&1
      pr=$?
      echo "walleye-init: shell on $TTY, start $n (probe rc $pr)" > /dev/kmsg 2>/dev/null
      t0=$(cut -d' ' -f1 /proc/uptime | tr -d .)
      setsid busybox ash -i <&4 >&4 2>&4 &
      p=$!
      st yes $p - $pr $TS
      wait $p
      rc=$?
      st yes $p $rc $pr $TS
      echo "walleye-init: shell on $TTY ended rc $rc, start $n" > /dev/kmsg 2>/dev/null
      exec 4<&-
      t1=$(cut -d' ' -f1 /proc/uptime | tr -d .)
      [ $((t1 - t0)) -lt 2000 ] && sleep 1
    else
      sleep 1
    fi
  done
) &
while :; do sleep 3600; done

#!/bin/busybox sh
# z4 (backlog walleye-shell-reliable) = pk5l (backlog walleye-pk5-light): the first mainline userspace on this phone, under our kernel with porthole's taimen dtb. A configfs gadget with two functions,
# acm.GS0 (a busybox ash on /dev/ttyGS0, respawned) and mass_storage.0 (a 2 MiB window rewritten every 5 s with uname, cmdline, dmesg, iomem, udc, pstore),
# serial walleye-first-boot, product "Pixel 2 walleye (mainline)". The SoC watchdog is opened and petted every 5 s for at most 180 s, longer while /tmp/hold exists
# (touch it from the shell); then reboot -f, with sysrq b behind it: the way back without hands. Never exits (an init that ends is a kernel panic); no `set -e`;
# every step says what it is about to do BEFORE it does it.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
say "pk5l init start, kernel $(uname -r)"
mkdir -p /sys/kernel/config /tmp /sys/fs/pstore
mount -t configfs none /sys/kernel/config
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
say "step pk5l: about to open /dev/watchdog"
if [ -e /dev/watchdog ]; then exec 3> /dev/watchdog; say "watchdog open"; else say "NO /dev/watchdog (the SoC watchdog did not probe)"; fi
LOGF=/tmp/walleye-log.img
say "step pk5l: about to create the 2 MiB log file"
dd if=/dev/zero of=$LOGF bs=1024 count=2048 2>/dev/null
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline)" > $G/strings/0x409/product
say "step pk5l: about to mkdir functions/acm.GS0 and mass_storage.0"
mkdir -p $G/functions/acm.GS0
mkdir -p $G/functions/mass_storage.0
L=$G/functions/mass_storage.0/lun.0
for a in ro removable; do if [ -e $L/$a ]; then echo 1 > $L/$a; else say "pk5l: no lun.0/$a"; fi; done
for a in cdrom nofua; do if [ -e $L/$a ]; then echo 0 > $L/$a; else say "pk5l: no lun.0/$a"; fi; done
say "step pk5l: about to set lun.0/file"
echo $LOGF > $L/file
say "step pk5l: about to mkdir configs/c.1/strings/0x409"
mkdir -p $G/configs/c.1/strings/0x409
echo "ACM+MSC" > $G/configs/c.1/strings/0x409/configuration
say "step pk5l: about to symlink both functions into configs/c.1"
ln -s $G/functions/acm.GS0 $G/configs/c.1/
ln -s $G/functions/mass_storage.0 $G/configs/c.1/
n=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $n -lt 30 ]; do sleep 1; n=$((n+1)); done
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ]; then say "NO UDC"; else say "step pk5l: about to bind $UDC"; echo "$UDC" > $G/UDC && say "gadget bound to $UDC"; fi

# the console (z4, backlog walleye-shell-reliable): a shell on the ACM tty that survives the host closing and reopening the port. The port is opened ONCE here (fd 4) and
# kept, so the tty is never freed between host opens; it is raw, no echo, no hangup on close (stty); the shell runs in its own session (setsid; no controlling terminal: busybox cttyhack ignores stdin, review) and
# is respawned at once when it ends (a shell that dies within 0.2 s waits 1 s, so a broken tty cannot spin). Every (re)start says so in the kmsg, with a counter.
(
  n=0
  while :; do
    if [ -c /dev/ttyGS0 ]; then
      command exec 4<> /dev/ttyGS0 || { sleep 1; continue; }
      stty -F /dev/ttyGS0 raw -echo -hupcl 2>/dev/null || echo "walleye-init: stty on /dev/ttyGS0 failed" > /dev/kmsg 2>/dev/null
      n=$((n+1))
      echo "walleye-init: shell on /dev/ttyGS0, start $n" > /dev/kmsg 2>/dev/null
      t0=$(cut -d' ' -f1 /proc/uptime | tr -d .)
      setsid busybox ash -i <&4 >&4 2>&4
      echo "walleye-init: shell on /dev/ttyGS0 ended, start $n" > /dev/kmsg 2>/dev/null
      exec 4<&-
      t1=$(cut -d' ' -f1 /proc/uptime | tr -d .)
      [ $((t1 - t0)) -lt 20 ] && sleep 1
    else
      sleep 1
    fi
  done
) &

# the window: every 5 s the first 64 KiB of the file is rewritten in place (text padded to 64 KiB); the watchdog is petted in the same round
n=0
while :; do
  echo >&3 2>/dev/null
  {
    echo "WALLEYE-LOG pk5l beat=$n up=$(cut -d' ' -f1 /proc/uptime)s hold=$([ -e /tmp/hold ] && echo yes || echo no)"
    echo "--- uname"; uname -a
    echo "--- cmdline"; cat /proc/cmdline
    echo "--- udc"; ls /sys/class/udc 2>&1; cat /sys/kernel/config/usb_gadget/g1/UDC 2>&1
    echo "--- pstore"; ls -l /sys/fs/pstore 2>&1
    echo "--- iomem"; head -n 40 /proc/iomem 2>&1
    echo "--- dmesg tail"; dmesg 2>&1 | tail -n 150 | tail -c 40000
    echo "--- end beat=$n"
  } > /tmp/walleye-text 2>&1
  dd if=/tmp/walleye-text of=$LOGF bs=65536 count=1 conv=sync,notrunc 2>/dev/null
  n=$((n+1))
  if [ $n -ge 36 ] && [ ! -e /tmp/hold ]; then break; fi
  sleep 5
done
say "self-reboot now"; sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

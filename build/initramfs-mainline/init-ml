#!/bin/busybox sh
# mainline-light (backlog walleye-mainline-first-light): OUR kernel's first init. It does the least that proves the kernel ran: a mass_storage gadget that shows itself
# to the host (serial walleye-first-boot, product "Pixel 2 walleye (mainline)", a 2 MiB LUN, the same one-way log window as vendor-gadget-m1), and the SoC watchdog opened and
# never petted, so the phone resets itself 30-60 s later (the way back without hands). No network function, so none of ncm's attribute writes.
# Never exits (an init that ends is a kernel panic); no `set -e`; every step says what it is about to do BEFORE it does it.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
say "mainline-light init start, kernel $(uname -r)"
mkdir -p /sys/kernel/config /tmp
mount -t configfs none /sys/kernel/config
say "step ml: about to open /dev/watchdog and keep it open, never petted"
if [ -e /dev/watchdog ]; then exec 3> /dev/watchdog; say "watchdog open"; else say "NO /dev/watchdog (the SoC watchdog did not probe)"; fi
LOGF=/tmp/walleye-log.img
say "step ml: about to create the 2 MiB log file"
dd if=/dev/zero of=$LOGF bs=1024 count=2048 2>/dev/null
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline)" > $G/strings/0x409/product
say "step ml: about to mkdir functions/mass_storage.0"
mkdir -p $G/functions/mass_storage.0
L=$G/functions/mass_storage.0/lun.0
for a in ro removable; do if [ -e $L/$a ]; then echo 1 > $L/$a; else say "ml: no lun.0/$a"; fi; done
for a in cdrom nofua; do if [ -e $L/$a ]; then echo 0 > $L/$a; else say "ml: no lun.0/$a"; fi; done
say "step ml: about to set lun.0/file"
echo $LOGF > $L/file
say "step ml: about to mkdir configs/c.1/strings/0x409"
mkdir -p $G/configs/c.1/strings/0x409
echo "MSC" > $G/configs/c.1/strings/0x409/configuration
say "step ml: about to symlink the function into configs/c.1"
ln -s $G/functions/mass_storage.0 $G/configs/c.1/
n=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $n -lt 30 ]; do sleep 1; n=$((n+1)); done
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ]; then say "NO UDC"; else say "step ml: about to bind $UDC"; echo "$UDC" > $G/UDC && say "gadget bound to $UDC"; fi

# the window: every 5 s the first 64 KiB of the file is rewritten in place (text padded to 64 KiB), 36 rounds = 180 s; the watchdog resets the phone before that
n=0
while [ $n -lt 36 ]; do
  {
    echo "WALLEYE-LOG ml beat=$n up=$(cut -d' ' -f1 /proc/uptime)s"
    echo "--- uname"; uname -a
    echo "--- cmdline"; cat /proc/cmdline
    echo "--- udc"; ls /sys/class/udc 2>&1; cat /sys/kernel/config/usb_gadget/g1/UDC 2>&1
    echo "--- dmesg tail"; dmesg 2>&1 | tail -n 150 | tail -c 50000
    echo "--- end beat=$n"
  } > /tmp/walleye-text 2>&1
  dd if=/tmp/walleye-text of=$LOGF bs=65536 count=1 conv=sync,notrunc 2>/dev/null
  n=$((n+1))
  sleep 5
done
say "self-reboot now"; sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

#!/bin/busybox sh
# t1 (backlog walleye-pstore-t1-sysrq-reset): the kernel is already alive on pk5; this init writes a marker to /dev/kmsg, waits 20 s (the SoC watchdog petted),
# then sysrq c (a deliberate crash; panic=5 is in the command line). After the return, Android reads console-ramoops: the marker there = the region survived.
# Never exits; no `set -e`; every step says what it does BEFORE it does it.
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

say() { echo "walleye-init: $*" > /dev/kmsg 2>/dev/null; echo "walleye-init: $*" > /dev/console 2>/dev/null; }
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
say "T1 MARKER walleye-t1-marker-7f3a init start, kernel $(uname -r)"
[ -e /dev/watchdog ] && say "watchdog present (petted by open-write-close; no exec, which would end init on a failed open)" || say "NO /dev/watchdog"
n=0
while [ $n -lt 20 ]; do
  echo > /dev/watchdog 2>/dev/null
  say "T1 MARKER walleye-t1-marker-7f3a tick $n"
  sleep 1
  n=$((n+1))
done
say "T1 MARKER walleye-t1-marker-7f3a about to sysrq c"
sync
echo c > /proc/sysrq-trigger
sleep 30
say "T1 sysrq c returned without a crash; reboot -f"
reboot -f; sleep 5; echo b > /proc/sysrq-trigger
while :; do sleep 3600; done

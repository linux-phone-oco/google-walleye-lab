#!/bin/busybox sh
# z10 = z6 plus the PON register reader (the z10 block below); z6 was: z5's init (banner2's proven banner on /dev/ttyGS0) with the console block REPLACED: no interactive ash (it stayed silent on the raw tty, research walleye-z5b-tried-raw-tty) but a plain
# read/exec command loop that needs no job control, no prompt and no controlling terminal. The port is opened ONCE (fd 4, raw, no echo, no hangup); then, one line at a time: read a line from fd 4 (a trailing CR dropped),
# run it with `sh -c` (stdin /dev/null) into /tmp/out, write /tmp/out to fd 4. No end marker of its own: the host reader's command carries its own (`CMD; echo wmsr-PID-N-END`, tests/host/mainline-shell-read.sh), so the answer ends where that echo is.
# The banner line keeps init-banner's fields and ends with the loop's state: loop=[started=yes|no starts=OPENS cmds=RUN last=[LAST COMMAND, unsafe characters made ?, 40 at most|-] rc=LAST EXIT|- err=[FIRST ERROR LINE|none]]
# Every banner line starts with WALLEYE-BANNER and ends with `]`, so the reader can leave it out and no line of it ever ends in an end marker. Every 10th beat from beat 3 a WALLEYE-BANNER-INFO line names the busybox applets and the tty flags.
# The SoC watchdog is opened and petted every 2 s by its own subshell, which after 90 beats (~180 s from the open) does reboot -f, sysrq b behind it.
# Never exits (an init that ends is a kernel panic); no `set -e`; no special builtin (exec, `:`) carries a redirect that can fail in the main shell (a failed one ends the shell).
/bin/busybox --install -s /bin
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
TTY=/dev/ttyGS0
SH=/tmp/sh
STEP=0
BANNERLOG=/tmp/banner-steps
say() { STEP=$((STEP+1)); echo "walleye-banner: step $STEP: $*" > /dev/kmsg 2>/dev/null; echo "step $STEP $*" >> $BANNERLOG 2>/dev/null; }
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /sys/kernel/config /tmp
true > $BANNERLOG 2>/dev/null
say "z10 init start, kernel $(uname -r)"
mount -t configfs none /sys/kernel/config
# z10 (backlog walleye-pmic-wdt-readback-image): the PON registers are read by the init itself, never armed. /bin/pon-regs reads them from the regmap debugfs (reads only) and prints one line per regmap that has the PON range:
#   pon-regs 0x54=XX 0x55=XX 0x56=XX 0x57=XX 0x5a=XX 0x5b=XX 0xc5=XX src=[REGMAP DIR]     (offsets in the PON block at 0x800; 0xc5 is the power-off reason)
# or `pon-regs none regmaps=[NAMES] dbgfs=[yes|no]`. A background reader runs it from the start until a line has values (the PMIC binds late), keeps it in /tmp/pon-regs; the banner writer prints it as WALLEYE-BANNER-PON; the command loop answers `pon-regs` live.
PONF=/tmp/pon-regs
cat > /bin/pon-regs <<'EOS'
#!/bin/sh
# reads only; DBG and NOMOUNT are for the host selftest. The kernel's regmap `registers` file has one fixed-width line "ADDR: VAL" per register and reads only the registers from the file position on: each of the seven is read with one dd of one line
# (not a scan of the 65536 registers); a line that is not the register asked for (a sparse map) falls back to grep for that register; a failed read shows XX in the kernel's line and ?? here.
DBG=${DBG:-/sys/kernel/debug}
D=$DBG/regmap
[ -d "$D" ] || [ -n "${NOMOUNT:-}" ] || mount -t debugfs none "$DBG" 2>/dev/null
found=0; names=
for d in "$D"/*; do
  f=$d/registers
  [ -f "$f" ] || continue
  n=${d##*/}; names="$names${names:+,}$n"
  E=$(head -n1 "$f" 2>/dev/null | wc -c)
  [ "$E" -gt 4 ] || continue
  line=; any=0
  for r in 54 55 56 57 5a 5b c5; do
    l=$(dd if="$f" bs="$E" skip=$((0x800 + 0x$r)) count=1 2>/dev/null)
    case $l in *8$r:*) ;; *) l=$(grep -E "^0*8$r:" "$f" 2>/dev/null | head -n1);; esac
    v=$(printf '%s\n' "$l" | sed -n "s/^0*8$r: *\([0-9a-fA-F][0-9a-fA-F]*\).*/\1/p" | head -n1)
    [ -n "$v" ] && any=1
    line="$line 0x$r=${v:-??}"
  done
  [ $any -eq 1 ] || continue
  echo "pon-regs$line src=[$n]"; found=1
done
if [ $found -eq 0 ]; then
  dbg=no; [ -d "$D" ] && dbg=yes
  echo "pon-regs none regmaps=[$names] dbgfs=[$dbg]"
fi
EOS
chmod 755 /bin/pon-regs
(
  n=0
  while [ $n -lt 60 ]; do
    /bin/pon-regs > $PONF.new 2>/dev/null
    if grep -q '0x54=[0-9a-fA-F]' $PONF.new 2>/dev/null; then mv $PONF.new $PONF; say "pon-regs read"; break; fi
    mv $PONF.new $PONF 2>/dev/null
    n=$((n+1)); sleep 2
  done
) &
say "about to start the watchdog petter"
# the petter: opens /dev/watchdog itself (its own subshell: a failed open ends only it), pets every 2 s, reboots after 90 beats
(
  if [ -e /dev/watchdog ]; then
    exec 3> /dev/watchdog || exit 0
  fi
  n=0
  while [ $n -lt 90 ]; do echo >&3 2>/dev/null; n=$((n+1)); sleep 2; done
  echo "walleye-banner: self-reboot now" > /dev/kmsg 2>/dev/null
  sync; reboot -f; sleep 5; echo b > /proc/sysrq-trigger
) &
[ -e /dev/watchdog ] || say "NO /dev/watchdog"
G=/sys/kernel/config/usb_gadget/g1
say "about to create the gadget g1 (1d6b:0104)"
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
echo 0x0100 > $G/bcdDevice
echo 0x0200 > $G/bcdUSB
mkdir -p $G/strings/0x409
echo "walleye-first-boot" > $G/strings/0x409/serialnumber
echo "linux-phone-oco" > $G/strings/0x409/manufacturer
echo "Pixel 2 walleye (mainline banner shell)" > $G/strings/0x409/product
say "about to mkdir functions/acm.GS0"
mkdir -p $G/functions/acm.GS0
# the banner writer, started before the bind: it waits for the tty node, then writes
(
  b=0
  while :; do
    if [ -c $TTY ]; then
      S=no; N=0; C=0; LC=-; LR=-; TTYSUM=unknown
      [ -f $SH.state ] && . $SH.state 2>/dev/null
      E=$(head -n1 $SH.err 2>/dev/null | tr -d '\r' | cut -c1-80); [ -n "$E" ] || E=none
      [ -f $SH.state ] || E="console block not run yet"
      printf "\n%s\n" "WALLEYE-BANNER beat=$b up=$(cut -d' ' -f1 /proc/uptime)s steps=$(wc -l < $BANNERLOG) last=[$(tail -n1 $BANNERLOG)] loop=[started=$S starts=$N cmds=$C last=[$LC] rc=$LR err=[$E]]" > $TTY 2>/dev/null
      P=$(cat $PONF 2>/dev/null | tr '\n' ' ' | sed 's/ $//'); [ -n "$P" ] || P="pon-regs not read yet"
      printf "\n%s\n" "WALLEYE-BANNER-PON beat=$b [$P]" > $TTY 2>/dev/null
      if [ $b -ge 3 ] && [ $((b % 10)) -eq 3 ]; then
        L=$(busybox --list 2>/dev/null)
        have() { case "
$L
" in *"
$1
"*) echo y;; *) echo n;; esac; }
        printf "\n%s\n" "WALLEYE-BANNER-INFO beat=$b busybox-applets=$(echo "$L" | wc -l) sh=$(have sh) stty=$(have stty) tr=$(have tr) cut=$(have cut) cat=$(have cat) tty=[$TTYSUM]" > $TTY 2>/dev/null
      fi
      b=$((b+1))
    fi
    sleep 2
  done
) &
say "banner writer started"
mkdir -p $G/configs/c.1/strings/0x409
echo "ACM" > $G/configs/c.1/strings/0x409/configuration
say "about to symlink acm.GS0 into configs/c.1"
ln -s $G/functions/acm.GS0 $G/configs/c.1/
n=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $n -lt 30 ]; do sleep 1; n=$((n+1)); done
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
if [ -z "$UDC" ]; then say "NO UDC after ${n}s"; else say "about to bind $UDC (waited ${n}s)"; echo "$UDC" > $G/UDC && say "gadget bound to $UDC"; fi

# the console, a command loop (backlog walleye-command-loop): the port is opened ONCE here (fd 4) and kept; raw, no echo, no hangup on close (stty). Then forever: read a line, run it, write the answer.
# State for the banner goes to /tmp/sh.state (shell variables it sources): S started, N opens of the port, C commands run, LC the last command (made safe to source), LR its exit status, TTYSUM the tty flags.
(
  n=0; c=0; lc=-; lr=-; ts=unknown
  CR=$(printf '\r')
  st() { { echo "S=$1; N=$n; C=$c; LC='$lc'; LR=$lr; TTYSUM=$ts"; } > $SH.state.new 2>/dev/null && mv $SH.state.new $SH.state; }
  st no
  while :; do
    if [ -c $TTY ]; then
      n=$((n+1))
      true > $SH.err
      { command exec 4<> $TTY; } 2>> $SH.err || { st no; sleep 1; continue; }
      stty -F $TTY raw -echo -hupcl 2>> $SH.err || echo "stty on $TTY failed" >> $SH.err
      A=" $(stty -F $TTY -a 2>/dev/null | tr '\n;' '  ') "
      flag() { case "$A" in *" -$1 "*) echo "$1=off";; *" $1 "*) echo "$1=on";; *) echo "$1=?";; esac; }
      ts="$(flag echo),$(flag icanon),$(flag hupcl)"
      echo "walleye-init: command loop on $TTY, open $n" > /dev/kmsg 2>/dev/null
      st yes
      bad=0
      while [ $bad -lt 50 ]; do
        if IFS= read -r line <&4; then
          bad=0
          line=${line%"$CR"}
          [ -n "$line" ] || continue
          lc=$(printf %s "$line" | tr -c 'A-Za-z0-9 ./_=:-' '?' | cut -c1-40)
          c=$((c+1)); lr=running; st yes   # the banner shows a command that has not ended
          sh -c "$line" < /dev/null > /tmp/out 2>&1
          lr=$?
          cat /tmp/out >&4 2>/dev/null
          st yes
        else
          bad=$((bad+1)); sleep 0.2
        fi
      done
      echo "walleye-init: command loop on $TTY lost its input, reopening (open $n)" > /dev/kmsg 2>/dev/null
      exec 4<&-
    else
      sleep 1
    fi
  done
) &
while :; do sleep 3600; done

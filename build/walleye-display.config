# Config fragment merged after walleye.config for the display path (item walleye-display-s6e3fa5): the initramfs carries no modules, so all =y.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3FA5=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# DRM_MSM "depends on X || X=n": a defconfig =m of these keeps DRM_MSM at =m
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_SMEM=y

# PMIC watchdog v1 images (item walleye-pmic-wdt-v1-image): on top of walleye.config, CONFIG_DYNAMIC_DEBUG only, so the boot command line can switch the pr_debug lines of
# drivers/watchdog/pm8916_wdt.c on (dyndbg="file drivers/watchdog/pm8916_wdt.c +p") and the banner shows the firmware's S2 type and that the probe's read-back passed.
# No DEBUG_GPIO (that one is the diagnostic kernel's, walleye-diag.config).
CONFIG_DYNAMIC_DEBUG=y

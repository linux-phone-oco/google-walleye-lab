# Config fragment on top of arm64 defconfig: what the first walleye boot needs, built in (the initramfs
# carries no modules). Anything the board does not need yet stays as defconfig has it.
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_CONFIGFS_FS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_MSM_MMCC_8998=y
CONFIG_PINCTRL_MSM8998=y
CONFIG_RD_GZIP=y
# first light (backlog walleye-mainline-first-light): the SoC watchdog resets the phone when the init never pets it
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_RD_XZ=y
# walleye-dmesg-clean: the GPU clock controller owns the power domain arm-smmu 5040000 waits on; defconfig has it =m and the initramfs carries no modules
CONFIG_MSM_GPUCC_8998=y
# walleye-charger-smb2: the SMB2 charger and the round-robin ADC it reads the USB input through; defconfig has neither and the initramfs carries no modules
CONFIG_QCOM_SPMI_RRADC=y
CONFIG_CHARGER_QCOM_SMB2=y
# walleye-kernel-pmic-wdt: the PMIC watchdog (qcom,pm8998-wdt) and its wake from suspend; the initramfs carries no modules
CONFIG_PM8916_WATCHDOG=y
